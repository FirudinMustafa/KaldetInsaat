generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  EDITOR
  VIEWER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum QuoteStatus {
  PENDING
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

// ============================================
// USER & AUTH MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  password      String
  role          UserRole  @default(EDITOR)
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  accounts      Account[]
  sessions      Session[]

  // Audit trails
  createdProjects    Project[]    @relation("CreatedBy")
  createdBlogPosts   BlogPost[]   @relation("CreatedBy")
  createdServices    Service[]    @relation("CreatedBy")

  @@index([email])
  @@index([deletedAt])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @db.VarChar(255)
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  deletedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([deletedAt])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  deletedAt     DateTime?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([deletedAt])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// CORE BUSINESS MODELS
// ============================================

model Project {
  id            String        @id @default(cuid())
  slug          String        @unique @db.VarChar(255)
  title         String        @db.VarChar(255)
  description   String        @db.Text
  location      String        @db.VarChar(255)
  client        String?       @db.VarChar(255)
  startDate     DateTime?
  endDate       DateTime?
  status        ProjectStatus @default(IN_PROGRESS)
  featured      Boolean       @default(false)

  // Metrics
  area          Float?        // m2
  budget        Float?
  duration      Int?          // days

  // SEO
  metaTitle     String?       @db.VarChar(255)
  metaDescription String?     @db.VarChar(500)

  // Media
  coverImage    String?
  images        ProjectImage[]
  videos        ProjectVideo[]

  // Relations
  serviceId     String?
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  testimonial   Testimonial?

  // Audit
  createdById   String
  createdBy     User          @relation("CreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  publishedAt   DateTime?
  isPublished   Boolean       @default(false)
  deletedAt     DateTime?

  @@index([slug])
  @@index([status])
  @@index([serviceId])
  @@index([featured])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("projects")
}

model ProjectImage {
  id          String   @id @default(cuid())
  url         String
  alt         String?  @db.VarChar(255)
  caption     String?  @db.Text
  order       Int      @default(0)
  isBefore    Boolean  @default(false)
  isAfter     Boolean  @default(false)
  deletedAt   DateTime?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([deletedAt])
  @@map("project_images")
}

model ProjectVideo {
  id          String   @id @default(cuid())
  url         String
  title       String?  @db.VarChar(255)
  thumbnail   String?
  order       Int      @default(0)
  deletedAt   DateTime?

  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@index([deletedAt])
  @@map("project_videos")
}

// ============================================
// SERVICES
// ============================================

model Service {
  id              String    @id @default(cuid())
  slug            String    @unique @db.VarChar(255)
  title           String    @db.VarChar(255)
  shortDescription String   @db.VarChar(500)
  description     String    @db.Text
  icon            String?
  coverImage      String?
  order           Int       @default(0)
  featured        Boolean   @default(false)

  // Process steps
  process         ServiceProcess[]

  // Materials/Features
  materials       ServiceMaterial[]

  // SEO
  metaTitle       String?   @db.VarChar(255)
  metaDescription String?   @db.VarChar(500)

  // Relations
  projects        Project[]
  quoteRequests   QuoteRequest[]

  // Audit
  createdById     String
  createdBy       User      @relation("CreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  isPublished     Boolean   @default(false)
  deletedAt       DateTime?

  @@index([slug])
  @@index([featured])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("services")
}

model ServiceProcess {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  description String   @db.Text
  order       Int
  icon        String?
  deletedAt   DateTime?

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
  @@index([deletedAt])
  @@map("service_processes")
}

model ServiceMaterial {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  order       Int
  deletedAt   DateTime?

  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([serviceId])
  @@index([deletedAt])
  @@map("service_materials")
}

// ============================================
// BLOG
// ============================================

model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique @db.VarChar(255)
  name        String     @db.VarChar(255)
  description String?    @db.Text
  order       Int        @default(0)
  deletedAt   DateTime?

  posts       BlogPost[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([slug])
  @@index([deletedAt])
  @@map("blog_categories")
}

model BlogPost {
  id              String         @id @default(cuid())
  slug            String         @unique @db.VarChar(255)
  title           String         @db.VarChar(255)
  excerpt         String         @db.VarChar(500)
  content         String         @db.Text
  coverImage      String?
  status          BlogPostStatus @default(DRAFT)
  featured        Boolean        @default(false)

  // SEO
  metaTitle       String?        @db.VarChar(255)
  metaDescription String?        @db.VarChar(500)
  keywords        String?        // JSON string array

  // Stats
  viewCount       Int            @default(0)

  // Relations
  categoryId      String?
  category        BlogCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags            BlogTag[]

  // Audit
  createdById     String
  createdBy       User           @relation("CreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  publishedAt     DateTime?
  deletedAt       DateTime?

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([featured])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("blog_posts")
}

model BlogTag {
  id    String    @id @default(cuid())
  name  String    @unique @db.VarChar(255)
  slug  String    @unique @db.VarChar(255)
  deletedAt DateTime?

  posts BlogPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([deletedAt])
  @@map("blog_tags")
}

// ============================================
// TEAM
// ============================================

model TeamMember {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(255)
  position    String   @db.VarChar(255)
  bio         String?  @db.Text
  image       String?
  email       String?  @db.VarChar(255)
  phone       String?  @db.VarChar(20)
  linkedin    String?
  order       Int      @default(0)

  isPublished Boolean  @default(true)
  deletedAt   DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deletedAt])
  @@map("team_members")
}

// ============================================
// TESTIMONIALS / REFERENCES
// ============================================

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String   @db.VarChar(255)
  companyName   String?  @db.VarChar(255)
  position      String?  @db.VarChar(255)
  content       String   @db.Text
  rating        Int      @default(5) // 1-5
  image         String?
  featured      Boolean  @default(false)
  deletedAt     DateTime?

  projectId     String?  @unique
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  isApproved    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([featured])
  @@index([isApproved])
  @@index([deletedAt])
  @@map("testimonials")
}

// ============================================
// CERTIFICATES & AWARDS
// ============================================

model Certificate {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(255)
  description String?  @db.Text
  issuer      String?  @db.VarChar(255)
  issueDate   DateTime?
  image       String?
  pdfUrl      String?
  order       Int      @default(0)
  deletedAt   DateTime?

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([deletedAt])
  @@map("certificates")
}

// ============================================
// FAQ
// ============================================

model FAQCategory {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(255)
  description String?       @db.Text
  order       Int           @default(0)
  deletedAt   DateTime?

  questions   FAQQuestion[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([slug])
  @@index([deletedAt])
  @@map("faq_categories")
}

model FAQQuestion {
  id          String       @id @default(cuid())
  question    String       @db.VarChar(500)
  answer      String       @db.Text
  order       Int          @default(0)
  deletedAt   DateTime?

  categoryId  String?
  category    FAQCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  isPublished Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([categoryId])
  @@index([deletedAt])
  @@map("faq_questions")
}

// ============================================
// CONTACT & QUOTE REQUESTS
// ============================================

model ContactSubmission {
  id          String        @id @default(cuid())
  name        String        @db.VarChar(255)
  email       String        @db.VarChar(255)
  phone       String?       @db.VarChar(20)
  companyName String?       @db.VarChar(255)
  subject     String?       @db.VarChar(500)
  message     String        @db.Text
  projectType String?       @db.VarChar(255)

  status      ContactStatus @default(NEW)
  notes       String?       @db.Text
  deletedAt   DateTime?

  // Metadata
  ipAddress   String?       @db.VarChar(50)
  userAgent   String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("contact_submissions")
}

model QuoteRequest {
  id              String       @id @default(cuid())

  // Client info
  name            String       @db.VarChar(255)
  email           String       @db.VarChar(255)
  phone           String?      @db.VarChar(20)
  companyName     String?      @db.VarChar(255)

  // Project details
  serviceId       String?
  service         Service?     @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectType     String?      @db.VarChar(255)
  area            Float?       // m2
  location        String?      @db.VarChar(255)
  description     String?      @db.Text
  budget          String?
  timeline        String?      @db.VarChar(100)

  // Calculated estimate
  estimatedPrice  Float?
  finalQuote      Float?
  quoteNotes      String?      @db.Text
  quotePdfUrl     String?

  status          QuoteStatus  @default(PENDING)
  deletedAt       DateTime?

  // Metadata
  ipAddress       String?      @db.VarChar(50)
  userAgent       String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  quotedAt        DateTime?

  @@index([status])
  @@index([serviceId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("quote_requests")
}

// ============================================
// MEDIA LIBRARY
// ============================================

model Media {
  id          String    @id @default(cuid())
  filename    String    @db.VarChar(500)
  url         String
  type        MediaType // IMAGE, VIDEO, DOCUMENT, OTHER
  mimeType    String    @db.VarChar(100)
  size        Int       // bytes
  alt         String?   @db.VarChar(255)
  caption     String?   @db.Text

  // Image specific
  width       Int?
  height      Int?

  // Organization
  folder      String?   @db.VarChar(255)
  tags        String?   // JSON string array
  deletedAt   DateTime?

  uploadedAt  DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type])
  @@index([folder])
  @@index([deletedAt])
  @@map("media")
}

// ============================================
// SITE SETTINGS
// ============================================

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(255)
  value     String   @db.Text
  type      String   @default("string") @db.VarChar(50) // string, number, boolean, json
  deletedAt DateTime?

  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([deletedAt])
  @@map("site_settings")
}

model SEOSettings {
  id          String   @id @default(cuid())
  page        String   @unique @db.VarChar(255) // homepage, about, services, etc.
  title       String   @db.VarChar(255)
  description String   @db.VarChar(500)
  keywords    String?  // JSON string array
  ogImage     String?
  deletedAt   DateTime?

  updatedAt   DateTime @updatedAt

  @@index([page])
  @@index([deletedAt])
  @@map("seo_settings")
}

// ============================================
// ANALYTICS
// ============================================

model PageView {
  id        String   @id @default(cuid())
  page      String   @db.VarChar(500)
  ipAddress String?  @db.VarChar(50)
  userAgent String?
  referrer  String?  @db.VarChar(500)
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([page])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("page_views")
}

model ConversionEvent {
  id        String   @id @default(cuid())
  type      String   @db.VarChar(100) // contact_form, quote_request, phone_click, etc.
  page      String?  @db.VarChar(500)
  data      String?  @db.Text // JSON string
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("conversion_events")
}
